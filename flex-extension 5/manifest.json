{
  "manifest_version": 3,
  "name": "FLEX Helper",
  "version": "1.0.0",
  "description": "Dark mode, randomized course-feedback filler, marks totals and GPA calculator for FLEX (flexstudent.nu.edu.pk).",
  "permissions": ["storage"],
  "host_permissions": ["https://flexstudent.nu.edu.pk/*"],
  "action": {
    "default_title": "FLEX Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://flexstudent.nu.edu.pk/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
